node_modules/
out/
media/vendor/
*.vsix

# The webview bundle. Built by esbuild from src/webview/main.ts, never edited in
# place and never committed: a checked-in build artifact is a stale one the
# moment someone edits the source and forgets to rebuild, and the check scripts
# read this file straight off disk.
media/preview.js
media/preview.js.map

# scratch logs left behind by debugging sessions
scripts/*.log*

# Local planning notes, kept as a working document rather than a published one.
# Also in .vscodeignore: vsce packages what is on disk, not what is in git, so
# ignoring it here would not keep it out of the .vsix.
ROADMAP.md
