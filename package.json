{
  "name": "graphite-md",
  "displayName": "graphite.md",
  "description": "A richer Markdown preview: collapsible sections, a git-graph style outline, checklists, math, and diagrams.",
  "version": "0.0.1",
  "publisher": "rog-stdioh",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ROG-stdioh/graphite-md.git"
  },
  "bugs": {
    "url": "https://github.com/ROG-stdioh/graphite-md/issues"
  },
  "homepage": "https://rog-stdioh.github.io/graphite-md/",
  "keywords": [
    "markdown",
    "preview",
    "outline",
    "mermaid",
    "katex",
    "math",
    "checklist",
    "dark theme"
  ],
  "galleryBanner": {
    "color": "#262624",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "graphiteMd.open",
        "title": "Open Preview",
        "category": "graphite.md",
        "icon": "$(open-preview)"
      },
      {
        "command": "graphiteMd.openToSide",
        "title": "Open Preview to the Side",
        "category": "graphite.md",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "graphiteMd.openToSide",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "graphiteMd.open",
          "when": "editorLangId == markdown"
        },
        {
          "command": "graphiteMd.openToSide",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "keybindings": [
      {
        "command": "graphiteMd.openToSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "graphite.md",
      "properties": {
        "graphiteMd.contentWidth": {
          "type": "number",
          "default": 60,
          "minimum": 40,
          "maximum": 100,
          "description": "Width of the reading column, as a percentage of the available preview pane width. Example: \"graphiteMd.contentWidth\": 60"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js && node scripts/copy-assets.js",
    "watch": "node esbuild.js --watch",
    "test:bdd": "cucumber-js",
    "check": "node scripts/render-check.js && node scripts/graph-check.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.21.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.16.9",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^10.9.1"
  }
}
